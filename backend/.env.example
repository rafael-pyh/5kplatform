# Configurações do Servidor
PORT=4000
NODE_ENV=development

# Banco de Dados
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/5kplatform?schema=public"

# JWT
JWT_SECRET=seu-secret-key-super-secreto-aqui-change-in-production
JWT_EXPIRES_IN=7d

# MinIO (S3) - Desenvolvimento
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=images
MINIO_QRCODE_BUCKET=qrcodes
MINIO_URL=http://localhost:9000

# MinIO (S3) - Railway Production
# Descomente e atualize com seus valores do Railway
# MINIO_ENDPOINT=seu-minio-service.railway.app
# MINIO_PORT=443
# MINIO_USE_SSL=true
# MINIO_ACCESS_KEY=seu-access-key
# MINIO_SECRET_KEY=seu-secret-key
# MINIO_BUCKET=images
# MINIO_QRCODE_BUCKET=qrcodes
# MINIO_URL=https://seu-minio-service.railway.app

# API URL (para gerar URLs públicas dos arquivos)
# Em desenvolvimento: http://localhost:4000
# Em produção: https://your-api.com
API_URL=http://localhost:4000

# Frontend URL
FRONTEND_URL=http://localhost:3000

# ===== CONFIGURAÇÃO DE EMAIL =====
# Opção 1: Gmail OAuth2 (Recomendado para produção)
# Como obter: https://developers.google.com/oauthplayground
GMAIL_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=seu-client-secret
GMAIL_REFRESH_TOKEN=seu-refresh-token
GMAIL_USER=seuemail@gmail.com

# Opção 2: App Password (Mais simples) ⭐ RECOMENDADO
# Como obter: https://myaccount.google.com/apppasswords
EMAIL_USER=seuemail@gmail.com
EMAIL_PASS=xxxxxxxxxxxxxxxx
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
MINIO_USE_SSL=false

# Frontend
FRONTEND_URL=http://localhost:3000