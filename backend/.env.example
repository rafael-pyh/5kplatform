# ===== SERVER CONFIGURATION =====
PORT=4000
NODE_ENV=development

# ===== DATABASE =====
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/5kplatform?schema=public"

# ===== CACHE (Memory-based LRU) =====
# Máximo de itens em cache (recomendado: 1000 para dev, 5000 para prod)
CACHE_MAX_SIZE=1000

# TTL padrão em milissegundos (padrão: 300000 = 5 minutos)
CACHE_TTL_MS=300000

# ===== JWT =====
JWT_SECRET=seu-secret-key-super-secreto-aqui-change-in-production
JWT_EXPIRES_IN=7d

# ===== URLS - CRITICAL SEPARATION =====
# URL INTERNA (Railway): usar .railway.internal | Backend-to-backend ONLY
# Exemplo: https://5kplatform-api.railway.internal
# NUNCA exponha via NEXT_PUBLIC_*
INTERNAL_API_URL=http://localhost:4000

# URL PÚBLICA: para frontend/browser acessar
# Exemplo: https://api.5kenergiasolar.com.br ou https://5kplatform-api.railway.app
PUBLIC_API_URL=http://localhost:4000

# Frontend URL: para CORS, redirects, emails
FRONTEND_URL=http://localhost:3000

# ===== STORAGE (S3/MinIO/Backblaze B2) =====
# Desenvolvimento (MinIO local)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=images
S3_QRCODE_BUCKET=qrcodes
S3_URL=http://localhost:9000
S3_USE_SSL=false

# Produção (Backblaze B2 ou AWS S3)
# S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# S3_REGION=us-east-005
# S3_ACCESS_KEY=your-app-key-id
# S3_SECRET_KEY=your-app-key
# S3_BUCKET=your-bucket-name
# S3_URL=https://your-bucket.s3.us-east-005.backblazeb2.com
# S3_USE_SSL=true

# ===== EMAIL CONFIGURATION =====
# Opção 1: Gmail App Password (RECOMENDADO para começar) ⭐
# Como obter: https://myaccount.google.com/apppasswords
EMAIL_USER=seu-email@gmail.com
EMAIL_PASS=seu-app-password-16-digitos
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Opção 2: Gmail OAuth2 (RECOMENDADO para produção)
# Como obter: https://developers.google.com/oauthplayground
# GMAIL_CLIENT_ID=seu-client-id.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=seu-client-secret
# GMAIL_REFRESH_TOKEN=seu-refresh-token
# GMAIL_USER=seu-email@gmail.com

# ===== LOGGING =====
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log SQL queries (development only)
# Desabilitar em produção para economizar CPU
LOG_SQL=false

# ===== FRONTEND .env.local (para referência) =====
# Não coloque em backend/.env!
# 
# NEXT_PUBLIC_API_URL=${PUBLIC_API_URL}
# 
# Nota: Use apenas PUBLIC_API_URL para o frontend!