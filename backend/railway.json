{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/Dockerfile"
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "variables": {
    "NODE_ENV": {
      "description": "Environment: production, development, or staging",
      "value": "production"
    },
    "S3_ENDPOINT": {
      "description": "S3 endpoint URL (e.g., s3.us-east-005.backblazeb2.com or s3.amazonaws.com)",
      "value": ""
    },
    "S3_REGION": {
      "description": "S3 region",
      "value": "us-east-1"
    },
    "S3_ACCESS_KEY": {
      "description": "S3 access key ID",
      "value": ""
    },
    "S3_SECRET_KEY": {
      "description": "S3 secret access key",
      "value": ""
    },
    "S3_BUCKET": {
      "description": "S3 bucket name for images",
      "value": "images"
    },
    "S3_QRCODE_BUCKET": {
      "description": "S3 bucket name for QR codes",
      "value": "qrcodes"
    },
    "S3_URL": {
      "description": "Public S3 URL base (for accessing uploaded files)",
      "value": ""
    }
  }
}

