# Dockerfile para desenvolvimento com hot reload
FROM node:20-alpine AS development

WORKDIR /app

# Instalar PostgreSQL client, bash e curl para o entrypoint
RUN apk add --no-cache postgresql-client bash curl

# Copiar arquivos básicos
COPY package*.json ./

# Instalar TODAS dependências (dev incluídas)
RUN npm install

# Copiar arquivos necessários, garantindo que os destinos sejam diretórios
COPY .sequelizerc /app/.sequelizerc
COPY config /app/config/
COPY src/migrations /app/src/migrations/
COPY src/seeders /app/src/seeders/

# Copiar entrypoint para rodar migrations no startup
COPY docker-entrypoint-dev.sh /usr/local/bin/docker-entrypoint-dev.sh
RUN chmod +x /usr/local/bin/docker-entrypoint-dev.sh

# Copiar o restante do código
COPY . .

# Expor porta
EXPOSE 4000

# Entrypoint que aguarda o Postgres e aplica migrations, o comando padrão inicia o dev server
ENTRYPOINT ["/usr/local/bin/docker-entrypoint-dev.sh"]
CMD ["npm", "run", "dev"]
