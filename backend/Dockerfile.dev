# Dockerfile para desenvolvimento com hot reload
FROM node:20-alpine AS development

WORKDIR /app

# Instalar PostgreSQL client para migrations
RUN apk add --no-cache postgresql-client

# Copiar arquivos básicos
COPY package*.json ./

# Instalar TODAS dependências (dev incluídas)
RUN npm install

# Copiar Sequelize config
COPY .sequelizerc ./
COPY config ./config
COPY src/migrations ./src/migrations
COPY src/seeders ./src/seeders

# Copiar o restante do código
COPY . .

# Expor porta
EXPOSE 4000

# Rodar migrations AUTOMÁTICAS no dev e iniciar
CMD ["sh", "-c", "npx sequelize-cli db:migrate && npm run dev"]
