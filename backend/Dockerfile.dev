# Dockerfile para desenvolvimento com hot reload
FROM node:20-alpine AS development

WORKDIR /app

# Copiar arquivos básicos
COPY package*.json ./
COPY prisma ./prisma/

# Instalar TODAS dependências (dev incluídas)
RUN npm install

# Gerar o Prisma Client
RUN npx prisma generate

# Copiar o restante do código
COPY . .

# Expor porta
EXPOSE 4000

# Rodar migrations AUTOMÁTICAS no dev
# > migrate dev cria o shadow DB e aplica mudanças
CMD ["sh", "-c", "npx prisma migrate dev --name \"auto-dev\" && npm run dev"]
